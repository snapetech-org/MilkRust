[preset00]
name=Night Drift 1
decay=0.94
wave_r=0.15
wave_g=0.45
wave_b=0.8
wave_a=0.15
wave_scale=0.6
zoom=1.0
rot=0.0
per_frame_1=q1=0.2+0.3*bass_att;
warp_shader_1=shader_body { ret=tex2D(sampler_main,uv).rgb*0.94; }
comp_shader_1=shader_body { float3 n=tex3D(sampler_noisevol_hq,float3(uv*0.5,time*0.01+0.0)).rgb; float v=pow(saturate(n.r*1.3),4.0); ret=float3(v*0.5,0.05+v*0.3,0.12+v*0.8); ret=saturate(ret*(0.75+q1)); }
