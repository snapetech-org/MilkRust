[preset00]
name=Ribbon Helix 3
decay=0.94
wave_r=0.15
wave_g=0.45
wave_b=0.8
wave_a=0.15
wave_scale=0.6
zoom=1.0
rot=0.0
per_frame_1=q1=0.2+0.3*bass_att;
warp_shader_1=shader_body { ret=tex2D(sampler_main,uv).rgb*0.94; }
comp_shader_1=shader_body { float v=0; for(int i=0;i<5;i++){ float y=0.5+0.3*sin(uv.x*7+time*0.2+1.3+float(i)*0.4); v+=0.012/(0.015+abs(uv.y-y)); } ret=saturate(float3(v*0.4,v*0.75,0.1+v*0.5)); ret=saturate(ret*(0.75+q1)); }
