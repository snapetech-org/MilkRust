[preset00]
name=Chromatic Waves 2
decay=0.94
wave_r=0.15
wave_g=0.45
wave_b=0.8
wave_a=0.15
wave_scale=0.6
zoom=1.0
rot=0.0
per_frame_1=q1=0.2+0.3*bass_att;
warp_shader_1=shader_body { ret=tex2D(sampler_main,uv).rgb*0.94; }
comp_shader_1=shader_body { float v=sin(uv.x*18+time*0.4+0.65)+cos(uv.y*15-time*0.3); ret=0.5+0.5*cos(float3(0,2.1,4.2)+v+time*0.05); ret=saturate(ret*(0.75+q1)); }
