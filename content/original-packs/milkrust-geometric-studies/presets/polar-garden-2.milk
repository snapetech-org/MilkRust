[preset00]
name=Polar Garden 2
decay=0.94
wave_r=0.15
wave_g=0.45
wave_b=0.8
wave_a=0.15
wave_scale=0.6
zoom=1.0
rot=0.0
per_frame_1=q1=0.2+0.3*bass_att;
warp_shader_1=shader_body { ret=tex2D(sampler_main,uv).rgb*0.94; }
comp_shader_1=shader_body { float2 p=uv-0.5; float a=atan2(p.y,p.x); float r=length(p); float v=0.5+0.5*cos(a*7+r*28-time*0.3+0.65); ret=float3(v*0.9,0.15+0.65*r,1-v*0.7); ret=saturate(ret*(0.75+q1)); }
