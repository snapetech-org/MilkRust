[preset00]
name=Orbital Lines 3
decay=0.94
wave_r=0.15
wave_g=0.45
wave_b=0.8
wave_a=0.15
wave_scale=0.6
zoom=1.0
rot=0.0
per_frame_1=q1=0.2+0.3*bass_att;
warp_shader_1=shader_body { ret=tex2D(sampler_main,uv).rgb*0.94; }
comp_shader_1=shader_body { float2 p=uv-0.5; float v=0; for(int i=0;i<4;i++){ float a=time*0.12+1.3+float(i)*1.5707963; float2 q=p-float2(cos(a),sin(a))*0.2; v+=0.1/(0.04+abs(length(q)-0.18)); } ret=saturate(float3(v*0.15,v*0.08,v*0.22)); ret=saturate(ret*(0.75+q1)); }
